        "src/mongo/db/index_builds/BUILD.bazel": "Removes the `//src/mongo/db/index_builds/primary_driven:tearable_side_write_redo_state` dependency from a mongo_cc_library target.",
        "src/mongo/db/repl/replication_coordinator_impl.cpp": "Removes the unused `kQuiesceModeShutdownMessage` constexpr string_view from the anonymous namespace.",
